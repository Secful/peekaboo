# AWS Credentials for Peekaboo
# Copy this file to .env and fill in your credentials
#
# AWS credentials enable:
# - Proxy support via AWS Secrets Manager
# - AI-powered API descriptions via AWS Bedrock

# Required AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional: Basic authentication for web interface
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=your_secure_password
